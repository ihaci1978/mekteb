			<DESCRIPTION>@COMPONENT.SCANNER_DESC.NEW@</DESCRIPTION>
			<DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Scanner_Driver.bmp</DISPLAY_ICON>
			<INSTALL_DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Scanner_Driver_32.png</INSTALL_DISPLAY_ICON>

			<COMP_DIR>$SRC_DIR$\Scanner</COMP_DIR>

			<!-- Installation type {NO,ALL,GRAYCHK,CHK,UNCHK} -->

		<__CFXML__>$INST_SRC_DIR$\Data\cf.xml</__CFXML__>
		<__CF_OFF_XML__>$INST_SRC_DIR$\Data\cfoff.xml</__CF_OFF_XML__>
		
		<__MANUAL_VIEWER__>$INST_SRC_DIR$\bin\ViewUserGuide.exe</__MANUAL_VIEWER__>
		<__MANUAL_DIR__>$SRC_DIR$\MANUAL</__MANUAL_DIR__>	
		<__MANUAL_VIEWER_DEST__>$PROGRAM_FILES_DIR$\__MFG__\View User Guide\ViewUserGuide.exe</__MANUAL_VIEWER_DEST__>
		<__USER_GUIDE_NAME_ZIP__>$SRC_DIR$\MANUAL\__MODEL__\$MANUAL_LANG_DIR$.zip</__USER_GUIDE_NAME_ZIP__>		
		<__OPEN_USER_GUIDE_ZIP_COMMAND__>__USER_GUIDE_NAME_ZIP__</__OPEN_USER_GUIDE_ZIP_COMMAND__>
		
		<__USER_GUIDE_NAME__>$SRC_DIR$\MANUAL\__MODEL__\$MANUAL_LANG_DIR$\Guide_$LANG_ABBR$.pdf</__USER_GUIDE_NAME__>
		<__TOTAL_UNINSTALLER_DEST__>$PROGRAM_FILES_DIR$\__MFG__\TotalUninstaller\TotalUninstaller.exe</__TOTAL_UNINSTALLER_DEST__>
		<__SETIP_PATH__>$SRC_DIR$\Application\SetIP\setup.exe</__SETIP_PATH__>
		<__WARRANTY_PATH__>$SRC_DIR$\Setup\Data\Warranty\warranty.pdf</__WARRANTY_PATH__>
		<__EPM_PARAM__>/P="$PORT$" /IP="$IP$" /DeviceID="Mode: $DEVICEID.MODE$" /ExtDeviceID="$EXTDEVICEID$"</__EPM_PARAM__>
		<__SCAN_ID_EXE__>$PROGRAM_FILES_DIR$\__MFG__\Easy Printer Manager\ScanIDDialog.exe</__SCAN_ID_EXE__>

	</STRINGS>
	

	<!-- Component Class Information -->

	<COMPONENT_CLASS_INFO>
		<!--
		<< Attributes >>
		- class : Inf Class Name
		- os    : OS Define String ex) WINXP,VISTA

		<< Sub Elements >>
			<INSTALLER> 		: Installer file
			<INST_PARAM> 		: Install Parameters
			<UNINST_PARAM> 		: Uninstall parameters
			<SUCCESS_RETURN>	: return value if success
-->

		<!-- Printer Class -->
		<COMPONENT_CLASS0 class="PRINTER">
			<INSTALLER>$INST_SRC_DIR$\bin\ssinstAD.exe</INSTALLER>
			<INST_PARAM>"$DEST_COMP_INF$" /M"$MDL$" /L"$LANG_ABBR$" /P"$PORT$" /O"$DRIVER_NAME$" /$DUPLEX$ /CF"$CFXML$"</INST_PARAM>
			<UNINST_PARAM>"$SRC_COMP_INF$" /U /M"$MDL$" /O"$DRIVER_NAME$"</UNINST_PARAM>
			<SUCCESS_RETURN>2</SUCCESS_RETURN>
		</COMPONENT_CLASS0>

		<!-- Image Class -->
<!--
		<COMPONENT_CLASS1 class="IMAGE">
			<INSTALLER>$INST_SRC_DIR$\bin\Wiainst.exe</INSTALLER>
			<INST_PARAM>"$SRC_COMP_INF$" /M"$MFG$" /W /l$LANG_ABBR$ /r /N"$IP$"</INST_PARAM>			
			<UNINST_PARAM>/U"$DRIVER_NAME$"/M"$MFG$" /p</UNINST_PARAM>
			<SUCCESS_RETURN>2</SUCCESS_RETURN>
		</COMPONENT_CLASS1>
-->

		<COMPONENT_CLASS1 class="IMAGE">
			<INSTALLER>$INST_SRC_DIR$\bin\Wiainst.exe</INSTALLER>
			<INSTALLER os="WINXP64">$INST_SRC_DIR$\bin\Wiainst64.exe</INSTALLER>
			<INSTALLER os="VISTA64">$INST_SRC_DIR$\bin\Wiainst64.exe</INSTALLER>
			<INSTALLER os="WIN8_64">$INST_SRC_DIR$\bin\Wiainst64.exe</INSTALLER>
			<INST_PARAM>"$DEST_COMP_INF$" /M"$MFG$" /W /l$LANG_ABBR$ /r /N"$IP$" /O"$PORT$"</INST_PARAM>
			<UNINST_PARAM>/U"$DRIVER_NAME$"/M"$MFG$" /p</UNINST_PARAM>
			<SUCCESS_RETURN>2</SUCCESS_RETURN>
		</COMPONENT_CLASS1>

		<!-- NonDevice Class -->
		<COMPONENT_CLASS2 class="NONDEVICE">
			<INSTALLER>$INST_SRC_DIR$\bin\ssndii.exe</INSTALLER>
			<INST_PARAM>"$SRC_COMP_INF$" /L $LANG_ABBR$ /D "$DEST_DIR$" /C "@SHORTCUT_MAINT.COMMON_FOLDER_NAME_EN@" /I"$IP$" /G"0x$0XLCID$"</INST_PARAM>
			<UNINST_PARAM>"$SRC_COMP_INF$" /U</UNINST_PARAM>
			<SUCCESS_RETURN>2</SUCCESS_RETURN>
		</COMPONENT_CLASS2>
	</COMPONENT_CLASS_INFO>

	<!-- Discovery type -->
	<DISCOVERY>
		<NETWORK max_snmp_size ="32"/>
	</DISCOVERY>

	<!-- Copy file information to be used when installing-->


	<INSTALL_COPY_FILE_INFO>
		<!--
	<< Attributes >>
	
	- copy_subdir: Copy subdirectory or not ("TRUE" or "FALSE") Default: "FALSE"
	- delete : Delete files and directories when uninstalling ("TRUE" or "FALSE") Default: "TRUE"
	- is64: Copy 64bit directory or not ("TRUE" or "FALSE") Default: "FALSE"
	- option
	
	<< Sub Elements >>
		<DESCRIPTION> 	: Description
		<SOURCE>		: Source directoy or file
		<DESTINATION>	: Destination directory or file
		<SUPPORTED_LANG>: Supported Language default: NULL (all supported langauges)
		<UNSUPPORTED_OS>: Unsupported OS default: NULL (all supported OSs)
			
-->
		
	  <!-- Installer Files -->
		<INSTALLER_BIN copy_subdir="TRUE" always_copy="TRUE">
			<DESCRIPTION>@FILE_COPY.INSTALLATION@</DESCRIPTION>
			<SOURCE> $SRC_DIR$\Setup\bin</SOURCE>
			<DESTINATION>$DEST_INST_DIR$\Setup\bin</DESTINATION>
		</INSTALLER_BIN>
	
		<INSTALLER_BITMAP extract_zip="TRUE" always_copy="TRUE">
			<DESCRIPTION>@FILE_COPY.INSTALLATION@</DESCRIPTION>
			<SOURCE> $SRC_DIR$\Setup\Data\Bitmap.zip</SOURCE>
			<DESTINATION>$DEST_INST_DIR$\Setup\Data\Bitmap.zip</DESTINATION>
		</INSTALLER_BITMAP>	

		<INSTALLER_WARRANTY copy_subdir="TRUE" always_copy="TRUE">
			<DESCRIPTION>@FILE_COPY.INSTALLATION@</DESCRIPTION>
			<SOURCE> $SRC_DIR$\Setup\Data\Warranty</SOURCE>
			<DESTINATION>$DEST_INST_DIR$\Setup\Data\Warranty</DESTINATION>
		</INSTALLER_WARRANTY>	
		
		<INSTALLER_SCRIPT copy_subdir="TRUE" always_copy="TRUE">
			<DESCRIPTION>@FILE_COPY.INSTALLATION@</DESCRIPTION>
			<SOURCE> $SRC_DIR$\Setup\Script</SOURCE>
			<DESTINATION>$DEST_INST_DIR$\Setup\Script</DESTINATION>
		</INSTALLER_SCRIPT>
		
		<INSTALLER_STRING extract_zip="TRUE" always_copy="TRUE">
			<DESCRIPTION>@FILE_COPY.INSTALLATION@</DESCRIPTION>
			<SOURCE> $SRC_DIR$\Setup\String.zip</SOURCE>
			<DESTINATION>$DEST_INST_DIR$\Setup\String.zip</DESTINATION>
		</INSTALLER_STRING>		
		
		<INSTALLER_FILES_SETUP_EXE always_copy="TRUE">
			<DESCRIPTION>@FILE_COPY.INSTALLATION@</DESCRIPTION>
			<SOURCE>$SRC_DIR$\setup.exe</SOURCE>
			<DESTINATION>$DEST_INST_DIR$\setup.exe</DESTINATION>
		</INSTALLER_FILES_SETUP_EXE>
	
		
		<!-- Copy Device Monitor Files -->
		<DEVMONDLL_WIN32 delete="FALSE">
			<DESCRIPTION>@FILE_COPY.INSTALLATION@</DESCRIPTION>
			<SOURCE>$INST_SRC_DIR$\DATA\DevMon\ssdevm.dll</SOURCE>
			<DESTINATION>$SYS_DIR$\ssdevm.dll</DESTINATION>
		</DEVMONDLL_WIN32>

		<DEVMONDLL_WIN64 delete="FALSE" supported_os="WINXP64, VISTA64, WIN8_64" is64="TRUE">
			<DESCRIPTION>@FILE_COPY.INSTALLATION@</DESCRIPTION>
			<SOURCE>$INST_SRC_DIR$\DATA\DevMon\ssdevm64.dll</SOURCE>
			<DESTINATION>$SYS_DIR$\ssdevm64.dll</DESTINATION>
		</DEVMONDLL_WIN64>
	

		<!-- Copy PRN file  -->
		<PRN_A4 always_copy="TRUE">

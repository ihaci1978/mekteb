		<__PUBLISHER__>Xerox Corporation</__PUBLISHER__>
		
		<__INSTALLER_FIE__>Setup.exe</__INSTALLER_FIE__>		

		<__MODEL_IMAGE__>$INST_SRC_DIR$\data\bitmap\Model\Model.gif</__MODEL_IMAGE__>

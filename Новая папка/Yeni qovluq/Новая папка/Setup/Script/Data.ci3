		<STR_SILENT_INSTALL.INVALID_SHARENAME>@SET_PRINTER_MSG_INVALID_SHARE_NAME@</STR_SILENT_INSTALL.INVALID_SHARENAME>
	</SILENT_INSTALL_STRINGS>
	
	

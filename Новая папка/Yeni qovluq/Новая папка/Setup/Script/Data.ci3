	<!-- OS Information
	<< Attributes >>
	- support_unknown = "LATEST" or "NO"
		."LATEST"	: Support unknown OS as latest version in the list
		."NO"		: not supported
-->
	<OS_INFO support_unknown="NO">

		<!--
	<< Atributes >>
	- platform_id:  (0,1,2) ==> Default : 2
		.VER_PLATFORM_WIN32s             0
		.VER_PLATFORM_WIN32_WINDOWS      1
		.VER_PLATFORM_WIN32_NT           2
	- major: Major Version
	- minor: Minor Version
	- x64  : 64bit or not ("TRUE" or "FALSE")
	- producttype: "PRO" (Professional) , "SER" (Server), "DOM" (Domain Server)
	- dir : fixed OS directory
		
	
-->

		<WINNT platform_id="2" major="4" minor="0" dir="WINNT"/>
		
		<WIN2K platform_id="2" major="5" minor="0" dir="WINXP_2000_VISTA_32"/>
			
		<WINXP platform_id="2" major="5" minor="1" dir="WINXP_2000_VISTA_32"/>

		<WINXP64 platform_id="2" major="5" x64="TRUE" dir="WINXP_VISTA_64"/>

		<VISTA platform_id="2" major="6" minor="0" dir="WINXP_2000_VISTA_32"/>

		<VISTA64 platform_id="2" major="6" minor="0" x64="TRUE" dir="WINXP_VISTA_64"/>
		
		<WIN8 platform_id="2" major="6" minor="2" dir="WINXP_2000_VISTA_32"/>

		<WIN8_64 platform_id="2" major="6" minor="2" x64="TRUE" dir="WINXP_VISTA_64"/>
	</OS_INFO>


	<!-- Set Altitude Command 
	<< Attributes >>
	- None
	
	<<Sub Element>>
		- <COMMAND> : Altitude Command String
-->

	<SET_ALTITUDE_INFO set_alti="TRUE">		
		<COMMAND>$INST_SRC_DIR$\bin\SSAlti.exe,  /p "$PORT$" /i "$IP$" /R "SOFTWARE\$MFG$\$PROGRAM_NAME$" /D "$INST_SRC_DIR$\Altitude\SSAlti.dat" </COMMAND>
	</SET_ALTITUDE_INFO>
	

	<TEST_PAGE>
		<COMMON>
			<FILE>$INST_SRC_DIR$\Data\PrintJob.CI3</FILE>
		</COMMON>

		<PRN>
			<FILE>$INST_SRC_DIR$\Data\Testpage.prn</FILE>
		</PRN>
		
		<DEMO>
			<FILE_A4>$INST_SRC_DIR$\Data\A4.prn</FILE_A4>
			<FILE_LETTER>$INST_SRC_DIR$\Data\Letter.prn</FILE_LETTER>
		</DEMO>
	</TEST_PAGE>

	<!-- Pre Install -->

	<PRE_INSTALL_INFO>
		
		<SSPORT_XP64 supported_os="WINXP64" is64="TRUE" delete="FALSE">	
			<SOURCE>$INST_SRC_DIR$\VECP\WIN64\SSPORT.SYS</SOURCE>
			<DESTINATION>$SYS_DIR$\drivers\SSPORT.SYS</DESTINATION>
		</SSPORT_XP64>
						
		<SSPORT_VISTA32 supported_os="VISTA, WIN8" delete="FALSE">	
			<SOURCE>$INST_SRC_DIR$\VECP\VISTA\SSPORT.SYS</SOURCE>
			<DESTINATION>$SYS_DIR$\drivers\SSPORT.SYS</DESTINATION>
		</SSPORT_VISTA32>	
		
		<SSPORT_VISTA64 supported_os="VISTA64, WIN8_64" is64="TRUE" delete="FALSE">	
			<SOURCE>$INST_SRC_DIR$\VECP\VISTA_64\SSPORT.SYS</SOURCE>
			<DESTINATION>$SYS_DIR$\drivers\SSPORT.SYS</DESTINATION>
		</SSPORT_VISTA64>	

	</PRE_INSTALL_INFO>


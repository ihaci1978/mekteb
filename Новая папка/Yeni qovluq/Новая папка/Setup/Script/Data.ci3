		<!-- EPM : Easy Printer Manager-->
		<EPM copy_file="FALSE" install_only="TRUE" size="51.8">
		
			<INSTALLED_VER rootkey="HKLM" key="Software\__MFG__\__MFG__PrinterLiveUpdate\SW\Common" value="EPM" wow_rd="FALSE"/>
			
			<SU_NAME>EPM</SU_NAME>	
			
			<DISPLAY_NAME>@COMPONENT.EPM@</DISPLAY_NAME>
			<DESCRIPTION>@COMPONENT.EPM_DESC@</DESCRIPTION>
			<DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\EPM.bmp</DISPLAY_ICON>	
			<INSTALL_DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\EPM_32.png</INSTALL_DISPLAY_ICON>
			<COMP_DIR>$SRC_DIR$\Application\EPM</COMP_DIR>

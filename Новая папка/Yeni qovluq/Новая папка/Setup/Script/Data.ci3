	<DCU
		cf_xml="$INST_SRC_DIR$\Data\smon.xml"
		cf_off_xml="$INST_SRC_DIR$\Data\smoff.xml"
		eed_cf_xml="$INST_SRC_DIR$\Data\eedon.xml"
		eed_cf_off_xml="$INST_SRC_DIR$\Data\eedoff.xml"

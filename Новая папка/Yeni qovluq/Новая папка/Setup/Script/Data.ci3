		sm_eed_cf_off_xml="$INST_SRC_DIR$\Data\smoffeedoff.xml"
		sm_on_eed_off_xml="$INST_SRC_DIR$\Data\smoneedoff.xml"
		sm_off_eed_on_xml="$INST_SRC_DIR$\Data\smoffeedon.xml"
		config_file_32="$INST_SRC_DIR$\bin\DrvConfig.exe"
		config_file_64="$INST_SRC_DIR$\bin\DrvConfig64.exe"
	/>
	
		
	<!-- Components information to be installed -->

	<COMPONENTS>

		<INSTALL_ORDER>
			<SPL_PCL/>
			<SPL/>
			<PCL/>
			<PS/>
			<XPS/>
			<SCANNER/>
			<SCANNER_INF/>
			<EPM/>
			<EDC/>
			<NETPCFAX/>			
			<OCR/>
			<WIRELESS_SETTING_PROGRAM/>
			<FIRMWARE/>
		</INSTALL_ORDER>
		<!-- 
	<< Attributes >>
	
	- class: inf class name
	- copy_file: Copy file option when installation "ALWAYS", "FALSE", "SELECT", "SELECT_ADDITIONAL_ONLY", "ALWAYS_ADDITIONAL_ONLY" (Default = "SELECT")
	- additional_copyfile: additional copy file information described under <FILE_INFO>
	- option
	
	<< Sub Elements >>
	
		<DISPLAY_NAME>	: display name string ( %s in the string will be translate with driver name )
		
		<DESCRIPTION>	: description name ( %s in the string will be translate with driver name )
		
		<INST_DESC>		: description when installing
		<REMOVE_DESC>	: description when uninstalling
		<REPAIR_DESC>	: description when repairing
		<TOOLTIP>		: Tooltip

		
		<COMP_DIR>		: Component root directory

		<INF_FILE>		: inf name		==> Automation value 
		
		<INST_CMD os="WINXP" type="exe">	: install command file  type: "exe", "in_cmd"(Internal command lilke as Create Shortcut)
		<INST_PARAM os="WINXP">	: install parameters
				
		<UNINST_CMD os="WINXP"> : uninstall command file
		<UNINST_PARAM os="WINXP"> : uninstall parameters
		
		<UNINST_KEY> : Uninstall Key

		Installation type : NO,ALL,GRAYCHK,CHK,UNCHK ,DEVCHK                 
		<INSTALL_MODE default="GRAYCHK" devchk_connect_install="CHK">
		  - default:  
		  - devchk_connect_install: 	it is available if installation type is "DEVCHK".
		                  						if devchk_connect_install="CHK" and the device is supports the components, the install mode shows as "Check" in component selection dialog.
		                  						CHK, UNCHK, GRAYCHK (Default : "CHK")
		  - devchk_not_connect_install: default installation option when the device is not available. 
		                        CHK,UNCHK, GRAYUNCHK, GRAYCHK (Default : "CHK")
		
			Customized installation type
			<SILENT_INST>
			<SMART_INST>
			<TYPICAL_LOCAL_INST>
			<TYPICAL_NETWORK_INST>
			<CUSTOM_LOCAL_INST>
			<CUSTOM_NETWORK_INST>
			<SOFTWARE_ONLY_INST>
		
		<DEVICE_STRING field="CMD,COMMAND" ext="TRUE">	: string in Device ID from a set, default field = "CMD,COMMAND", ext (using extend device id) default= false

		<UNSUPPORTED_OS> : Unsupported OS list
		
		Information for printers
				
		<INF_32>	: 32bit inf name		==> Automation value 
		<INF_64>	: 64bit inf name		==> Automation value 
        
		<SHARE_NAME>: shared name (Default is the printer name) 	==> Automation value 
                                                               		
		<DEFAULT_PRINTER> : Set default printer ("TRUE" or "NOT") ==> Automation value                                                               			
		
		
		<SU_NAME> : component name for Smart Update 
			Printer Driver (PCL)
			Printer Driver (SPL)
			Printer Driver (PS)
			Printer Driver (XPS)
			Scan Driver
			Smart Panel Software
			Scan Manager Software
			Network Scan Software
			Printer Settings Utility
			Set IP Software
			Smarthru 4 Software
			Smarthru Office Software
			Direct Printing Utility
			PC Fax Software
			
			EPM
			EDM
			Scan Assistant 
			Scan Manager
			Printer Driver (SPLPCL)
-->
		
		<FIRMWARE>
			<SU_NAME>FIRMWARE</SU_NAME>
						
			<DISPLAY_NAME>@COMPONENT.FIRMWARE@</DISPLAY_NAME>
			<DESCRIPTION>Firmware Display Name Description</DESCRIPTION>
			<DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Driver.bmp</DISPLAY_ICON>
		
		</FIRMWARE>
		
		<SPL_PCL class="Printer">
			
			<INSTALLED_VER rootkey="HKLM" key="Software\__MFG__\__MFG__PrinterLiveUpdate\SW\__MODEL__" value="SPL" wow_rd="TRUE"/>
			
			<SU_NAME>SPL_PCL</SU_NAME>
			<DISPLAY_NAME>@COMPONENT.PRINTER@</DISPLAY_NAME>
			<DESCRIPTION>@COMPONENT.PRINTER_DESC.NEW@</DESCRIPTION>
			<DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Driver.bmp</DISPLAY_ICON>
			<INSTALL_DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Driver_32.png</INSTALL_DISPLAY_ICON>

			<COMP_DIR>$SRC_DIR$\PRINTER\SPL_PCL</COMP_DIR>

			<!-- Installation type {NO,ALL,CHK,CHK,UNCHK} -->
			<INSTALL_MODE default="CHK">
				<SOFTWARE_ONLY_INST>NO</SOFTWARE_ONLY_INST>
				<SILENT_INST>CHK</SILENT_INST>
				<ONE_COMP_INST>CHK</ONE_COMP_INST>
				<MINIMUM_INST>CHK</MINIMUM_INST>
			</INSTALL_MODE>
		</SPL_PCL>

		<!-- SPL Mono Printer driver -->
		<SPL class="Printer" size="27.1">
			<INSTALLED_VER rootkey="HKLM" key="Software\__MFG__\__MFG__PrinterLiveUpdate\SW\__MODEL__" value="SPL" wow_rd="TRUE"/>
			<SU_NAME>SPL</SU_NAME>
			<DISPLAY_NAME>@COMPONENT.PRINTER@</DISPLAY_NAME>
			<DESCRIPTION>@COMPONENT.PRINTER_DESC.NEW@</DESCRIPTION>
			<DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Driver.bmp</DISPLAY_ICON>
			<INSTALL_DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Driver_32.png</INSTALL_DISPLAY_ICON>

			<COMP_DIR>$SRC_DIR$\PRINTER\SPL</COMP_DIR>

			<!-- Installation type {NO,ALL,GRAYCHK,CHK,UNCHK} -->
			<INSTALL_MODE default="CHK">
				<SOFTWARE_ONLY_INST>NO</SOFTWARE_ONLY_INST>
				<SILENT_INST>CHK</SILENT_INST>
				<ONE_COMP_INST>CHK</ONE_COMP_INST>
				<MINIMUM_INST>CHK</MINIMUM_INST>
			</INSTALL_MODE>
		</SPL>


		<!-- PCL Mono Printer driver -->
		<PCL class="Printer" size="15.8">
		
			<INSTALLED_VER rootkey="HKLM" key="Software\__MFG__\__MFG__PrinterLiveUpdate\SW\__MODEL__" value="PCL" wow_rd="TRUE"/>
			
			<SU_NAME>PCL</SU_NAME>

			<DISPLAY_NAME>@COMPONENT.PRINTER@</DISPLAY_NAME>
			<DESCRIPTION>@COMPONENT.PRINTER_DESC.NEW@</DESCRIPTION>
			<DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Driver.bmp</DISPLAY_ICON>
			<INSTALL_DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Driver_32.png</INSTALL_DISPLAY_ICON>

			<COMP_DIR>$SRC_DIR$\PRINTER\PCL</COMP_DIR>

			<!-- Installation type {NO,ALL,GRAYCHK,CHK,UNCHK} -->
			<INSTALL_MODE default="CHK">
				<SOFTWARE_ONLY_INST>NO</SOFTWARE_ONLY_INST>
				<SILENT_INST>CHK</SILENT_INST>
				<ONE_COMP_INST>CHK</ONE_COMP_INST>
				<MINIMUM_INST>CHK</MINIMUM_INST>
			</INSTALL_MODE>
			
			
		</PCL>


		<PS class="Printer" size="25.9" >
		
			<INSTALLED_VER rootkey="HKLM" key="Software\__MFG__\__MFG__PrinterLiveUpdate\SW\__MODEL__" value="PS" wow_rd="TRUE"/>

			<SU_NAME>PS</SU_NAME>
			
			<DISPLAY_NAME>@COMPONENT.PRINTER@</DISPLAY_NAME>
			<DESCRIPTION>@COMPONENT.PRINTER_DESC.PS.NEW@</DESCRIPTION>
			<DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Driver.bmp</DISPLAY_ICON>
			<INSTALL_DISPLAY_ICON>$INST_SRC_DIR$\data\bitmap\Driver_32.png</INSTALL_DISPLAY_ICON>

			<COMP_DIR>$SRC_DIR$\PRINTER\PS</COMP_DIR>

			<!-- Installation type {NO,ALL,GRAYCHK,CHK,UNCHK} -->
			<INSTALL_MODE default="UNCHK">
				<SOFTWARE_ONLY_INST>NO</SOFTWARE_ONLY_INST>
				<SILENT_INST>CHK</SILENT_INST>
				<ONE_COMP_INST>CHK</ONE_COMP_INST>
				<MINIMUM_INST>UNCHK</MINIMUM_INST>
			</INSTALL_MODE>
		</PS>


	
		

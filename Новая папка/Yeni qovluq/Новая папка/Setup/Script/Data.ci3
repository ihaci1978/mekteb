	<!-- Shortcut Information -->

	<SHORTCUT_INFO>

		<!--
	<< Attributes >>
	- group: Shorcut group ("START" or "DESKTOP") Default : "START"
	- delete: delete shorcut when uninstalling ("TRUE" or "FALSE") Default : "TRUE"
	- permission: user permission ("CURRENT" or "ALL") Default: "ALL"
	- option
	
	<< Sub Elements >>
		
		<NAME>: Shorcut Name
		<TARGET>: Shortuct target file or web address
		<ARGUMENT>: Argument of target
		<ICON_FILE>: Icon File path ( - index (icon file index) default = 0)
		<FOLDER_NAME>: Shortcut folder name
		<DESCRIPTION>: Shortcut description
		<UNSUPPORTED_LANG>: Supported Language default: NULL (all supported langauges)   ex: WINNT,WINXP
		<UNSUPPORTED_OS>: Unsupported OS default: NULL (all supported OSs)		ex: EN,PT
		
-->

		<TOTAL_UNINSTALL_SHORTCUT_MUI unsupported_os="WIN2K" delete="FALSE">
			<NAME>Uninstall __MFG__ Printer Software</NAME>
			<TARGET>__TOTAL_UNINSTALLER_DEST__</TARGET>
			<ARGUMENT>/N"__MFG__" /REMOVE_ALL</ARGUMENT>
			<ICON_FILE index="0">__TOTAL_UNINSTALLER_DEST__</ICON_FILE>
			<FOLDER_NAME>__MFG__ Printers</FOLDER_NAME>
			<MUI_RES_DLL>__TOTAL_UNINSTALLER_DEST__</MUI_RES_DLL>
			<MUI_RES_ID>151</MUI_RES_ID>							
		</TOTAL_UNINSTALL_SHORTCUT_MUI>
		
		
		<MANUAL_VIEWER_SHORTCUT supported_os="WIN2K" delete="FALSE" is_manual="TRUE">
			<NAME>@SHORTCUT_MANUAL.NAME@</NAME>
			<TARGET>__MANUAL_VIEWER_DEST__</TARGET>
			<ARGUMENT>/VIEW /N "__MFG__"</ARGUMENT>
			<ICON_FILE index="0">__MANUAL_VIEWER_DEST__</ICON_FILE>
			<FOLDER_NAME>__MFG__ Printers</FOLDER_NAME>
		</MANUAL_VIEWER_SHORTCUT>

		
		<MANUAL_VIEWER_SHORTCUT_MUI  unsupported_os="WIN2K" delete="FALSE" is_manual="TRUE">
			<NAME>View User's Guide</NAME>
			<TARGET>__MANUAL_VIEWER_DEST__</TARGET>
			<ARGUMENT>/VIEW /N "__MFG__"</ARGUMENT>			
			<ICON_FILE index="0">__MANUAL_VIEWER_DEST__</ICON_FILE>
			<FOLDER_NAME>__MFG__ Printers</FOLDER_NAME>
			<MUI_RES_DLL>__MANUAL_VIEWER_DEST__</MUI_RES_DLL>
			<MUI_RES_ID>144</MUI_RES_ID>							
		</MANUAL_VIEWER_SHORTCUT_MUI>

		
		
	
	</SHORTCUT_INFO>





	<!-- Registry Information to be used by registry commands (Write Registry, Delete Registry -->

	<REGISTRY_INFO>

		<!-- 
	<< Attributes >>
	- rootkey  : Registry Root Key ("HKLM" or "HKCU") Default: "HKLM"
	- delete   : Delete Key when uninstalling ("TRUE" or "FALSE") Default : "TRUE"
	- option
	- allaccess
	- wow_rd
	
	<< Sub Elements >>
		<KEY>	: registry Key name
		<VALUE>	: Registry Value
			- name : Value name
			- type : Value type ("REG_DWORD" or "REG_SZ") default "REG_SZ"
					if REG_DWORD and value is 0X???? ==> it is hexadecimal
	                if REG_DWORD and Value is ????   ==> it is decimal
-->
		<!-- Uninstall key -->
		<UNINSTALL_KEY rootkey="HKLM" delete="TRUE">
			<KEY>Software\Microsoft\Windows\CurrentVersion\uninstall\$PROGRAM_NAME$</KEY>
			<VALUE0 type="REG_SZ" name="DisplayName">$PROGRAM_NAME$</VALUE0>
			<VALUE1 type="REG_SZ" name="UninstallString">"$DEST_INST_DIR$\__INSTALLER_FIE__" /R</VALUE1>
			<VALUE2 type="REG_SZ" name="DisplayIcon">$DEST_INST_DIR$\__INSTALLER_FIE__</VALUE2>
			<VALUE3 type="REG_SZ" name="Publisher">__PUBLISHER__</VALUE3>
			<VALUE4 type="REG_DWORD" name="NoModify">1</VALUE4>
			<VALUE5 type="REG_DWORD" name="NoRepair">1</VALUE5>
			<VALUE6 type="REG_SZ" name="DisplayVersion">$VERSION$ ($DATE$)</VALUE6>
			<VALUE7 type="REG_SZ" name="UninstallString_XeroxSilent">"$DEST_INST_DIR$\__INSTALLER_FIE__" /s /d /t</VALUE7>
			<VALUE8 type="REG_SZ" name="Description">@MAININST.DESCRIPTION@</VALUE8>
			<VALUE9 type="REG_DWORD" name="Description_ID">199</VALUE9>
		</UNINSTALL_KEY>
		
		
		<MANUAL_SHORTCUT_KEY rootkey="HKLM" delete="FALSE">
			<KEY>Software\Microsoft\Windows\CurrentVersion\uninstall\View User Guide</KEY>
			<VALUE0 type="REG_SZ" name="UninstallString_XeroxSilent">__MANUAL_VIEWER_DEST__ /uninstall</VALUE0>
			<VALUE1 type="REG_SZ" name="Description">@SHORTCUT_MANUAL.NAME@</VALUE1>
		</MANUAL_SHORTCUT_KEY>

		
		<!-- User Guide Path for Smart Panel -->
		<USER_GUIDE_KEY rootkey="HKLM" delete="TRUE">
			<KEY>Software\$MFG$\$PROGRAM_NAME$\Installed</KEY>
			<VALUE0 type="REG_SZ" name="UserGuideDir">$DEST_INST_DIR$\MANUAL\__MODEL__\$MANUAL_LANG_DIR$</VALUE0>
			<VALUE1 type="REG_SZ" name="UserGuideFile">Guide_$LANG_ABBR$.pdf</VALUE1>
		</USER_GUIDE_KEY>
		
		
		<!-- AMPV -->
		<AMPV_TRUE_64 rootkey="HKLM" delete="TRUE"  supported_os="WINXP64, VISTA64, WIN8_64" wow_rd="TRUE" allaccess="TRUE">
			<KEY>Software\__MFG__\WEB_AGREEMENT\__MODEL__</KEY>
			<VALUE0 type="REG_DWORD" name="AMPVAgree">1</VALUE0>

		<!-- Easy Document Creator -->
		<EDC  class="EXE"  copy_file="FALSE" install_only="TRUE" size="25">		
			<INSTALLED_VER rootkey="HKLM" key="Software\__MFG__\__MFG__PrinterLiveUpdate\SW\Common" value="Easy Document Creator" wow_rd="TRUE"/>
			
			<SU_NAME>EDC</SU_NAME>
			
